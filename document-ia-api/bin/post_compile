#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export UV_SYSTEM_PYTHON=1

# Le monorepo est un unique workspace uv (un seul uv.lock à la racine). `uv sync`
# du buildpack a donc déjà installé document-ia-schemas et document-ia-infra dans
# le virtualenv, en copies réelles puisque UV_NO_EDITABLE=1 est défini sur l'app.
# L'ancienne copie dans vendor/ + `uv pip install -e` n'est plus nécessaire et
# échouerait de toute façon : ces paquets se déclarent désormais membres du
# workspace (tool.uv.sources.* = { workspace = true }).
cd "$APP_ROOT"

echo "[post_compile] vérification des libs locales installées par le workspace"
uv run --no-project python - <<'PY'
import importlib.util

for module in ("document_ia_schemas", "document_ia_infra"):
    if importlib.util.find_spec(module) is None:
        raise SystemExit(f"[post_compile] {module} est absent du virtualenv")
PY
