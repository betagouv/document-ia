meta {
  name: Execute Workflow Sync
  type: http
  seq: 2
}

post {
  url: {{server}}api/v1/workflows/{{workflow_id}}/execute-sync
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  metadata: {"test":"test"} @contentType(String)
  file: @file(/Users/nsagon/Downloads/aadf6b84ef205a90e2531d3c211194372efe7722.jpg)
  ~extraction-parameters: {"document-type": "cni"}
  ~classification-parameters: {"document-types": ["cni", "passeport"]}
}

vars:pre-request {
  workflow_id: document-barcode-raw-extraction
}

settings {
  encodeUrl: true
  timeout: 0
}
