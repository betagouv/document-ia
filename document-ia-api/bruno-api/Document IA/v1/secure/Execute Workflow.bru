meta {
  name: Execute Workflow
  type: http
  seq: 1
}

post {
  url: {{server}}api/v1/workflows/{{workflow_id}}/execute
  body: multipartForm
  auth: inherit
}

headers {
  ~Idempotency-Key: {{idempotency_key}}
}

body:multipart-form {
  metadata: {"test":"test"} @contentType(String)
  file: @file(/Users/nsagon/Downloads/f3910feb-b841-418b-ac51-92567cc4bc47.pdf)
  ~classification-parameters: {"document-types": ["cni", "passeport"]}
  ~extraction-parameters: {"document-type": "cni"}
}

vars:pre-request {
  workflow_id: document-extraction-mistral-v1
  ~idempotency_key: test-idemp-001
}

script:pre-request {
  // Décommenter pour générer automatiquement une nouvelle clé aléatoire à chaque requête :
  // bru.setVar("idempotency_key", crypto.randomUUID());
}

script:post-response {
  bru.setVar("execution_id", res.body.data.execution_id);
}

settings {
  encodeUrl: true
  timeout: 0
}
