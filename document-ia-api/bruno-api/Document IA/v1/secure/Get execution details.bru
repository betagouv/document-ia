meta {
  name: Get execution details
  type: http
  seq: 3
}

get {
  url: {{server}}api/v1/executions/{{execution_id}}?is_debug_mode=true
  body: none
  auth: apikey
}

params:query {
  is_debug_mode: true
}

auth:apikey {
  key: X-Api-Key
  value: {{admin-api-key}}
  placement: header
}

vars:pre-request {
  execution_id: bd975cc6-e5b0-47f7-8814-51af57c6165d
}

settings {
  encodeUrl: true
  timeout: 0
}
