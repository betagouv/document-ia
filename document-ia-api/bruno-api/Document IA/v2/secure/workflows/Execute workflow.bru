meta {
  name: Execute workflow
  type: http
  seq: 2
}

post {
  url: {{server}}api/v2/workflows/{{worfklow_id}}/execute
  body: multipartForm
  auth: inherit
}

headers {
  ~Idempotency-Key: {{idempotency-key}}
}

body:multipart-form {
  override: '''
    {
      "extract_content_ocr" : [
        {
          "param" : "model",
          "value" : "tesseract"
        }
      ]
    }
  '''
  file: @file(/Users/nsagon/Projects/files/Avis_d_impot_2025_sur_les_revenus_2024.pdf) @contentType(application/pdf)
}

vars:pre-request {
  worfklow_id: document-classification-extraction-v2
  ~idempotency-key: test-idemp-002
}

script:pre-request {
  // Décommenter pour générer automatiquement une nouvelle clé aléatoire à chaque requête :
  // bru.setVar("idempotency_key", crypto.randomUUID());
}

settings {
  encodeUrl: true
  timeout: 0
}
