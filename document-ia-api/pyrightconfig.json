{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "typeCheckingMode": "strict",
  "reportMissingTypeStubs": false,
  "include": [
    "src"
  ],
  "ignore": [
    "**/pycache",
    "**/tests/**",
    "alembic/versions"
  ],
  "extraPaths": [
    "src",
    "src/document_ia_api",
    "../document-ia-schemas/src",
    "../document-ia-infra/src"
  ]
}
