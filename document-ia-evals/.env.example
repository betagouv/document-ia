# Example environment variables
# Copy this file to .env and update with your actual values

# Application Settings
APP_TITLE="Streamlit App"
DEBUG=false

# Label Studio Configuration (for Experiments page)
LABEL_STUDIO_URL=
LABEL_STUDIO_API_KEY=

DOCUMENT_IA_API_KEY=
DOCUMENT_IA_BASE_URL=

# API Keys (if needed)
# API_KEY=your_api_key_here

# Database Configuration
# PostgreSQL runs on port 5435 (not 5432) to avoid conflicts with system PostgreSQL
POSTGRESQL_URL=postgresql://postgres:postgres@localhost:5435/experiments_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=experiments_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# For Docker network connection (if running Streamlit in a container):
# POSTGRESQL_URL=postgresql://postgres:postgres@postgres:5432/experiments_db
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Other Settings
# MAX_UPLOAD_SIZE=200

# ProConnect / OpenID Connect Authentication
AUTH_BYPASS_LOCAL=false
PROCONNECT_CLIENT_ID=
PROCONNECT_CLIENT_SECRET=
PROCONNECT_METADATA_URL=https://fca.integ01.dev-agentconnect.fr/api/v2/.well-known/openid-configuration
PROCONNECT_REDIRECT_URI=http://localhost:8501/oauth2callback
# python3 -c "import secrets; print(secrets.token_hex(32))"
PROCONNECT_COOKIE_SECRET=
PROCONNECT_SCOPES="openid email profile"
PROCONNECT_POST_LOGOUT_REDIRECT_URI=http://localhost:8501/
